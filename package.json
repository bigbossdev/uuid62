{
    "name": "@bboss/uuid62",
    "version": "1.3.1",
    "description": "UUID to Base62 encoding/decoding library for Node.js",
    "keywords": [
        "uuid",
        "base62",
        "encoding",
        "decoding",
        "typescript",
        "nodejs"
    ],
    "author": "bigboss.dev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bigbossdev/uuid62.git"
    },
    "bugs": {
        "url": "https://github.com/bigbossdev/uuid62/issues"
    },
    "homepage": "https://github.com/bigbossdev/uuid62#readme",
    "main": "dist/cjs/index.js",
    "types": "dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*.ts",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=16.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/postbuild.js && node scripts/verify-dual-build.js",
        "typecheck": "tsc -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.5",
        "jest": "^30.5.2",
        "rimraf": "^6.1.4",
        "ts-jest": "^29.4.15",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "glob": "^14.0.6",
        "minimatch": "^11.0.9"
    }
}
